grid = [
    ['S', '.', '#'],
    ['.', '.', '.'],
    ['#', '.', 'G']
]

visited = []

def move(x, y):

    if x < 0 or x >= 3 or y < 0 or y >= 3:
        return

    if grid[x][y] == '#' or (x, y) in visited:
        return

    visited.append((x, y))
    print("Agent position:", x, y)

    if grid[x][y] == 'G':
        print("Goal Reached!")
        return True

    if move(x, y+1):
        return True

    if move(x+1, y):
        return True

    if move(x, y-1):
        return True

    if move(x-1, y):
        return True

    return False


move(0, 0)
