def alphabeta(tree, alpha, beta, isMax):

    if type(tree) == int:
        return tree

    if isMax:
        best = -999
        for child in tree:
            value = alphabeta(child, alpha, beta, False)
            best = max(best, value)
            alpha = max(alpha, best)

            if alpha >= beta:
                break

    else:
        best = 999
        for child in tree:
            value = alphabeta(child, alpha, beta, True)
            best = min(best, value)
            beta = min(beta, best)

            if alpha >= beta:
                break

    return best


tree = [
    [[3, 5], [6, 9]],
    [[2, 4], [7, 8]]
]

print("Optimal Value:", alphabeta(tree, -999, 999, True))
